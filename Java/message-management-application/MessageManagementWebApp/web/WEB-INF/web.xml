<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>StartServlet</servlet-name>
        <servlet-class>za.ac.tut.web.StartServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>NameServlet</servlet-name>
        <servlet-class>za.ac.tut.web.NameServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SendMessageServlet</servlet-name>
        <servlet-class>za.ac.tut.web.SendMessageServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RemoveServlet</servlet-name>
        <servlet-class>za.ac.tut.web.RemoveServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ViewAllMessagesServlet</servlet-name>
        <servlet-class>za.ac.tut.web.ViewAllMessagesServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ViewPerCategoryServlet</servlet-name>
        <servlet-class>za.ac.tut.web.ViewPerCategoryServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>WorstPerformingAgentServlet</servlet-name>
        <servlet-class>za.ac.tut.web.WorstPerformingAgentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StartServlet</servlet-name>
        <url-pattern>/StartServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>NameServlet</servlet-name>
        <url-pattern>/NameServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SendMessageServlet</servlet-name>
        <url-pattern>/SendMessageServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RemoveServlet</servlet-name>
        <url-pattern>/RemoveServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ViewAllMessagesServlet</servlet-name>
        <url-pattern>/ViewAllMessagesServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ViewPerCategoryServlet</servlet-name>
        <url-pattern>/ViewPerCategoryServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>WorstPerformingAgentServlet</servlet-name>
        <url-pattern>/WorstPerformingAgentServlet.do</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <context-param>
        <param-name>computer_name</param-name>
        <param-value>Siri</param-value>
    </context-param>
</web-app>
